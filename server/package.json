{
  "name": "agla-station-server",
  "version": "1.0.0",
  "description": "Realtime sync server for aglaStation",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "simulate": "ts-node scripts/simulate-clients.ts"
  },
  "dependencies": {
    "agla-station-shared": "file:../shared",
